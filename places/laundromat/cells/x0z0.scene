  receiveShadow: true
  rotation: {yaw: 0}
lm-street:
  feetPosition: {x: -2, y: 4.5, z: 6}
  id: lm-street
  light: {aim: {x: 0, y: 0, z: -3}, angle: 60, color: oklch(0.75 0.15 60), distance: 22, intensity: 14, kind: spot, penumbra: 0.7, shadow: {enabled: true}}
lm-street-ground:
  feetPosition: {x: 0, y: -0.02, z: 6}
  id: lm-street-ground
  material: {color: oklch(0.18 0.01 250), metalness: 0.3, repeat: [6, 3], roughness: 0.15, texture: cdn/texture-wet-black-asphalt.png, wrap: repeat}
  primitive: {height: 12, kind: plane, width: 30}
  rotation: {pitch: -90}
