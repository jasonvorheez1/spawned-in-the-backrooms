intake-light-a:
  feetPosition: {x: 0, y: 2.8, z: -1.6}
  id: intake-light-a
  light: {color: oklch(0.95 0.06 95), distance: 9, intensity: 5, kind: point, shadow: {enabled: false}}
intake-light-b:
  feetPosition: {x: 0, y: 2.8, z: 1}
