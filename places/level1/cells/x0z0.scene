meg-ale:
  behavior: scripts/meg-agent.js
  feetPosition: {x: 6.6, y: 0, z: 3.4}
  id: meg-ale
  jiggle: {amount: 0.6, bones: [Tail*, Ear*], bounce: 0.6}
  material: {outline: {color: "#1d1420", width: 2.4}}
  physics: character
  primitive: {kind: scripted, params: {bottom: "#4a5a3a", botw: pants, expr: smile, hat: cap, hatc: "#b6e04a", sex: f, shoec: "#2a2420", shoes: boots, species: fox, top: "#b6e04a", topw: jacket}, script: scripts/critter-geo.js}
  rotation: {yaw: 90}
  state: {angry: {}, home: {x: 6.072, z: 2.619}, name: "Ale · M.E.G. Scout", role: scout}
  tags: [npc]
