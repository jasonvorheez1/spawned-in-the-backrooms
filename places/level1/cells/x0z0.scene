# spawn-scene v2 yaml x0z0
meg-ale:
  behavior: scripts/meg-agent.js
  feetPosition: {x: 6.6, y: 0, z: 3.4}
  id: meg-ale
  jiggle: {amount: 0.6, bones: [Tail*, Ear*], bounce: 0.6}
  material: {outline: {color: "#1d1420", width: 2.4}}
  physics: {body: kinematic, collider: capsule}
  primitive: {kind: scripted, params: {bottom: "#4a5a3a", botw: pants, expr: smile, hat: cap, hatc: "#b6e04a", sex: f, shoec: "#2a2420", shoes: boots, species: fox, top: "#b6e04a", topw: jacket}, script: scripts/critter-geo.js}
  rotation: {yaw: 90}
  state: {name: "Ale · M.E.G. Scout", role: scout}
  tags: [npc]
meg-callum:
  behavior: scripts/meg-agent.js
  feetPosition: {x: 11.9, y: 0, z: 2.4}
  id: meg-callum
  jiggle: {amount: 0.6, bones: [Tail*, Ear*], bounce: 0.6}
  material: {outline: {color: "#1d1420", width: 2.4}}
  physics: {body: kinematic, collider: capsule}
  primitive: {kind: scripted, params: {bottom: "#4a5a3a", botw: pants, expr: grin, hat: beanie, hatc: "#7a3a2a", sex: m, shoec: "#2a2420", shoes: boots, species: bear, top: "#b6e04a", topw: jacket}, script: scripts/critter-geo.js}
  rotation: {yaw: 90}
  state: {name: "Callum · Quartermaster", role: quarter}
  tags: [npc]
meg-ortiz:
  behavior: scripts/meg-agent.js
  feetPosition: {x: 15.5, y: 0, z: 0.3999999999999999}
  id: meg-ortiz
  jiggle: {amount: 0.6, bones: [Tail*, Ear*], bounce: 0.6}
  material: {outline: {color: "#1d1420", width: 2.4}}
  physics: {body: kinematic, collider: capsule}
  primitive: {kind: scripted, params: {bottom: "#4a5a3a", botw: pants, expr: smile, neck: scarf, neckc: "#b6e04a", sex: f, shoec: "#2a2420", shoes: boots, species: bunny, top: "#eef2f0", topw: jacket}, script: scripts/critter-geo.js}
  rotation: {yaw: 90}
  state: {name: "Dr. Ortiz · M.E.G. Medic", role: medic}
  tags: [npc]
