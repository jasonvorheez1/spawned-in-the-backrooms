# spawn-scene v2 yaml x0z0
l12-ceil:
  castShadow: false
  feetPosition: {x: 0, y: 3, z: 0}
  id: l12-ceil
  material: {color: oklch(0.97 0.006 95), repeat: [1, 1], roughness: 0.92, texture: cdn/texture-flat-white-painted-plaster-wall-faint-roller-marks.png, wrap: repeat}
  physics: static
  primitive: {depth: 6.3, height: 0.1, kind: box, width: 6.3}
l12-chair:
  feetPosition: {x: 0, y: 0, z: 0.45}
  id: l12-chair
  model: {id: /cdn/value.b579afa379fe0730c5aaa825796dba3705faf3c6b1ab0a11aaa6e326405aabe9.glb}
  physics: static
  rotation: {yaw: 180}
l12-chair-seat:
  feetPosition: {x: 0, y: 0, z: 0.45}
  id: l12-chair-seat
  rotation: {yaw: 0}
  state: {name: Chair, seat: {d: 0.02, w: 1, y: 0.44}, verb: Sit}
  tags: [seat]
l12-clock:
  audio: {clip: cdn/moodboard-realistic-gritty/sfx-wall-clock-slow-mechanical-tick-tock-loop.mp3, gain: 0.25, loop: true, maxDistance: 7, spatial: true}
  castShadow: false
  children: [{feetPosition: {x: 0, y: -0.03, z: 0}, material: {color: "#1a1a1a"}, primitive: {kind: torus, radius: 0.22, tube: 0.018}, rotation: {pitch: 90}}]
  feetPosition: {x: 0, y: 2.55, z: -2.91}
  id: l12-clock
  material: {color: oklch(0.97 0.004 95), roughness: 0.4}
  pivot: center
  primitive: {height: 0.05, kind: cylinder, radialSegments: 40, radiusBottom: 0.22, radiusTop: 0.22}
  rotation: {pitch: 90}
