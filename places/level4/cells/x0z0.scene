# spawn-scene v2 yaml x0z0
l4-detail:
  castShadow: false
  feetPosition: {x: 0, y: 0, z: 0}
  id: l4-detail
  material: {roughness: 0.9}
  primitive: {kind: scripted, script: scripts/level4-detail-geo.js}
  receiveShadow: true
l4-fun-poster:
  children: [{behavior: scripts/level-door.js, feetPosition: {x: 0, y: 0, z: 0}, physics: {body: static, trigger: true}, primitive: {depth: 0.9, height: 1.6, kind: box, width: 0.9}, rotation: {pitch: 90}, state: {to: level26}, visible: false}]
  feetPosition: {x: 34, y: 0.02, z: -27}
  id: l4-fun-poster
  material: {roughness: 0.95, texture: /cdn/value.8d29187c9d1ff71bb79ca79db24e350421d27f62bad5cee4c68ce68bb2ce32f2.png}
  primitive: {height: 0.66, kind: plane, width: 0.45}
  rotation: {pitch: -90, roll: 37}
l4-geo:
  castShadow: false
  feetPosition: {x: 0, y: 0, z: 0}
  id: l4-geo
  material: {roughness: 0.9}
  physics: {body: static, collider: mesh}
  primitive: {kind: scripted, params: {cut: []}, script: scripts/level4-geo.js}
  receiveShadow: true
l4-lift-arrive:
  feetPosition: {x: 28.7, y: 0.1, z: -27}
  id: l4-lift-arrive
  rotation: {yaw: 180}
l4-lift-door:
  behavior: scripts/level-door.js
  feetPosition: {x: 31.299999999999997, y: 0, z: -28}
  id: l4-lift-door
  physics: {body: static, trigger: true}
  primitive: {depth: 1.6, height: 2.3, kind: box, width: 0.6}
  state: {to: level3#l3-lift-arrive}
  tags: [door]
  visible: false
l4-office-1-cooler:
  behavior: scripts/l4-home.js
  castShadow: false
  children: [{feetPosition: {x: 0, y: 0.95, z: 0}, material: {color: oklch(0.8 0.08 230 / 0.55), roughness: 0.1, transparent: true}, primitive: {height: 0.42, kind: cylinder, radiusBottom: 0.16, radiusTop: 0.15}}, {feetPosition: {x: 0, y: 1.45, z: 0}, primitive: {depth: 0.01, height: 0.01, kind: box, width: 0.01}, ui: "<div face=\"front\" facing=\"player\" width=\"0.42m\" style=\"font-family:monospace;color:#cfeeff;background:#0e1a22;padding:14px;font-size:44px;line-height:1.2\">JUGS {{ state.jugs | default 3 }}/3<div style=\"margin-top:8px;height:40px;background:#223;position:relative\"><div style=\"position:absolute;left:82%;width:14%;top:0;bottom:0;background:#2f6a3a\"></div><div style=\"position:absolute;left:0;top:8px;bottom:8px;width:{{ state.fill | round }}%;background:#7fd6ff\"></div></div>FILL {{ state.fill | round | default 0 }}%</div>", visible: true}]
  feetPosition: {x: -16.6, y: 0, z: -26.55}
  id: l4-office-1-cooler
  layout: {box: {max: {x: 0.18, y: 1.2, z: 0.18}, min: {x: -0.18, y: 0, z: -0.18}}}
  model: {id: /cdn/value.40b1e114cdbad77d13350e630508cf974d8b20422cbfbe323ad5769a7fed6014.glb}
  physics: static
  rotation: {yaw: 360}
  state: {c: {x: -16.6, y: 1.1, z: -26.55}, fill: 0, info: Your office's almond water, jugs: 3, kind: cooler, name: Water cooler, plate: l4-office-1-plate, tint: "#7fd6ff", verb: Fill a bottle}
  tags: [usable, l4-cooler]
  visibleRange: {max: 45}
l4-office-1-plate:
  behavior: scripts/l4-home.js
  feetPosition: {x: -20.95, y: 1.35, z: -25.87}
  id: l4-office-1-plate
  material: {color: oklch(0.86 0.03 85), roughness: 0.5}
  primitive: {depth: 0.03, height: 0.32, kind: box, width: 0.5}
  rotation: {yaw: 180}
  state: {info: "Vacant office · make it your home", kind: claim, label: "4-01", label2: vacant, name: Office 4-01, room: {id: l4-office-1, kit: {cot: {x: -18.4, y: 0, z: -30.6}, desk: {x: -22.4, y: 0, z: -30.9}, yaw: 360}}, tint: "#f2c14e", verb: Claim}
  tags: [usable, l4-plate]
  castShadow: false
  visibleRange: {max: 45}
  ui: "<div face=\"front\" width=\"0.5m\" style=\"font-family:sans-serif;text-align:center;color:#2a2620;line-height:1.05\"><div style=\"font-size:150px;font-weight:900\">4-01</div><div style=\"font-size:62px\">{{ state.label2 }}</div></div>"
