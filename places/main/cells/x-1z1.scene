# spawn-scene v2 yaml x-1z1
flicker-wall:
  audio: {clip: cdn/moodboard-realistic-gritty/sfx-electric-buzz-crackle-loop.mp3, gain: 0.35, loop: true, maxDistance: 16, spatial: true}
  feetPosition: {x: -111.86, y: 0, z: 102}
  id: flicker-wall
  material: {color: oklch(0.97 0.03 92), emissive: oklch(0.75 0.08 92), emissiveIntensity: 0.35, repeat: [1.4, 1.5], roughness: 0.9, texture: /cdn/value.00a4e744acf9ab763779bbb0cc7f26fb1dd20aeafc69448c536939cd7212caeb.png, wrap: repeat}
  primitive: {depth: 0.04, height: 2.9, kind: box, width: 2.8}
  rotation: 90
flicker-wall-fx:
  feetPosition: {x: -111.71, y: 0, z: 102}
  fx: {script: "fx\npop glow n=1 at=<0,1.4,0> lv=flick(7,.9) r=light(<1,.93,.7>,$lv*3.5,6)\npop tear rate=?mobile:4|8 on=box(.01,1.3,1.3) life=.05..0.14 size=.02..0.05 len=.6..1.8 col=hdr(1.5,1.4,1) a=.6 sz=$size asp=$len/$size r=sprite(soft-disc,add)\npop fleck rate=?mobile:10|20 on=box(.01,1.4,1.4) life=.05..0.12 size=.015..0.04 col=<.15,.13,.08> a=.8 sz=$size r=sprite(soft-disc,alpha)"}
  id: flicker-wall-fx
