# spawn-scene v2 yaml x1z-1
l132-keep:
  children: [{feetPosition: {x: 1.5, y: 24.6, z: 1}, fx: {script: "fx\npop smoke rate=?low:2|mobile:3|5 on=disc(.35) life=5..8 v=up(.7..1.1)+sdir()*.15 size=.6..1 acc=buoy(.15)+curl(.2)*.4+drag(.35)+wind()*.3 sz=$size*(.6>3.4) col=<.42,.4,.4>><.3,.3,.32> a=0>.1:.32>.6:.18>0 rot=spin(.05) r=sprite(smoke-puff,alpha)"}, id: chimney}, {feetPosition: {x: 0, y: 14.7, z: -5.6}, fx: {script: "fx\npop pane n=1 at=point() size=1.6 col=hdr(2.2,1.4,.45)*flick(.6,.08) a=.85 sz=$size r=sprite(soft-disc,add)\npop halo n=1 at=point() size=3.4 col=hdr(1,.6,.18) a=.35 sz=$size r=sprite(soft-disc,add)"}, id: window}]
  feetPosition: {x: 110, y: 9, z: -110}
  id: l132-keep
  layout: {box: {max: {x: 15, y: 24, z: 15}, min: {x: -15, y: 0, z: -15}}}
  model: {forward: "+x", id: /cdn/value.a92782e59096074bea629f7d39e65eb7a1e647660f3564d917e8808867d000be.glb}
  physics: {body: static, collider: mesh}
  rotation: {yaw: 135}
  state: {name: The Duke's Palace}
  tags: [l132, l132-palace]
