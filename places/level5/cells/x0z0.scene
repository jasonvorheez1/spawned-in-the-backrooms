# spawn-scene v2 yaml x0z0
l5-ball-banner:
  feetPosition: {x: 8, y: 2, z: 23.78}
  id: l5-ball-banner
  rotation: {yaw: 180}
  tags: [l5-ball]
  vector: "<svg viewBox='0 0 480 200' width='4.6m'><rect x='0' y='0' width='480' height='200' fill='#1c2a3a'/><rect x='8' y='8' width='464' height='184' fill='none' stroke='#c9b46a' stroke-width='4'/><text x='240' y='108' font-family='display' font-size='92' fill='#e9e1c4' text-anchor='middle'>M.E.G.</text><text x='240' y='160' font-family='sans-serif' font-size='30' fill='#c9b46a' text-anchor='middle'>OUTPOST · HOUSEKEEPING</text></svg>"
l5-ball-barcart:
