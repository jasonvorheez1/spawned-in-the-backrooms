  physics: {body: static, collider: box}
  primitive: {kind: scripted, params: {part: coatcheck}, script: scripts/l5-ball-geo.js}
  rotation: {yaw: -90}
  state: {hp: 90, items: "bobbypin,ammo,battery", kind: counter, mat: wood, maxHp: 90, name: Coat check}
  tags: [container, furniture, lootfurn, breakable, l5-ball]
l5-ball-fire:
  audio: {clip: /cdn/moodboard-realistic-gritty/sfx-fireplace-crackle-loop.mp3, gain: 0.35, loop: true, maxDistance: 12, spatial: true}
  feetPosition: {x: 6, y: 0.26, z: -23.5}
  fx: {script: "fx\npop coals n=10 on=disc(.35) size=.06..0.12 tint=<2.4,.9,.25>..<1.1,.3,.08> sz=$size*flick(.5,.12) col=$tint*flick(.8,.3) a=.9 r=sprite(soft-disc,add)\npop flame rate=flick(.45,.2)*50 on=disc(.3) life=.5..0.9 v=up(1.2)+cone(20)*(.2..0.6) size=.18..0.32 acc=curl(.5)*1.1+buoy(1.8)+drag(1.6) sz=$size*(.5>.25:1>.7:.7>.14) col=hdr(4.6,3.4,1.4)>.3:hdr(3.2,1.4,.3)>.65:hdr(1.8,.5,.1)>hdr(.6,.12,.03) a=0>.12:1>.75:.85>0 rot=spin(.2) r=sprite(flame-wisp,add)\npop embers rate=3 on=disc(.3) life=.6..1.1 v=up(1.6)+cone(25)*(.3..0.8) size=.02..0.04 acc=curl(.8)+grav()*.4+drag(.6) sz=$size col=hdr(5,2.8,.8)>hdr(1,.22,.04) a=(0>.08:1>.65:.9>0)*flick(11,.35) r=sprite(ember,add,velocity,.02)\npop glow n=1 at=disc(.2).c(.5) glo=fire()*(#flame/30)~ r=light(<1,.55,.24>,$glo*14,9)"}
  id: l5-ball-fire
  tags: [l5-ball]
