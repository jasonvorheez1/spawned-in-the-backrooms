  audio: {clip: /cdn/moodboard-realistic-gritty/sfx-faint-hushed-whispers-inside-roaring-furnace-loop.mp3, gain: 0.4, loop: true, maxDistance: 12, spatial: true}
  feetPosition: {x: 27, y: 0.66, z: -16.25}
  fx: {script: "fx\npop coals n=10 on=box(.6,.03,.35) size=.08..0.16 tint=<2.4,.9,.25>..<1.1,.3,.08> sz=$size*flick(.5,.12) col=$tint*flick(.8,.3) a=.9 r=sprite(soft-disc,add)\npop flame rate=flick(.45,.25)*?mobile:30|55 on=box(.6,.02,.3) life=.35..0.7 v=up(1.1)+cone(18)*(.2..0.5) size=.2..0.38 acc=curl(.5)*1.2+buoy(1.6)+drag(1.8) sz=$size*(.5>.25:1>.7:.7>.14) col=hdr(4.6,3.0,1.2)>.3:hdr(3.2,1.3,.3)>.65:hdr(1.8,.5,.1)>hdr(.6,.12,.03) a=0>.12:1>.75:.85>0 rot=spin(.2) r=sprite(flame-wisp,add)\npop embers rate=3 on=box(.6,.02,.3) life=.5..1 v=up(1.4)+cone(35)*(.3..0.9) size=.02..0.04 acc=curl(.8)+grav()*.3+drag(.6) col=hdr(5,2.6,.7)>hdr(1,.22,.04) a=(0>.1:1>.7:.9>0)*flick(11,.35) r=sprite(ember,add,velocity,.02)\npop glow n=1 at=point().c(.5) glo=fire()*(#flame/30)~ r=light(<1,.5,.2>,$glo*14+3,9)"}
