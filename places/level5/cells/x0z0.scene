l5-ball-cig:
  feetPosition: {x: 5.66, y: 0.77, z: -0.4}
  fx: {script: "fx\npop wisp rate=flick(.3,.5)*3 on=point() life=3..5 v=up(.12..0.2)+sdir()*.03 size=.03..0.05 acc=curl(.4)*.15+buoy(.05)+drag(.6) sz=$size*(1>5) col=<.55,.53,.5> a=0>.15:.25>.6:.12>0 rot=spin(.1) r=sprite(smoke-puff,alpha)"}
  id: l5-ball-cig
  tags: [l5-ball]
l5-ball-coatcheck:
  feetPosition: {x: -4.7, y: 0, z: 7.7}
  id: l5-ball-coatcheck
