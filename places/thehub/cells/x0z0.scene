  material: {color: oklch(0.95 0.06 85), emissive: oklch(0.95 0.06 85), emissiveIntensity: 6}
  primitive: {kind: sphere, radius: 0.09}
hub-baylight-1:
  castShadow: false
  feetPosition: {x: 20, y: 3.6, z: -10}
  id: hub-baylight-1
  light: {color: oklch(0.88 0.09 82), distance: 11, intensity: 3.5, kind: point, shadow: {enabled: false}}
  material: {color: oklch(0.95 0.06 85), emissive: oklch(0.95 0.06 85), emissiveIntensity: 6}
  primitive: {kind: sphere, radius: 0.09}
hub-baylight-2:
  castShadow: false
  feetPosition: {x: 27, y: 3, z: -6.5}
