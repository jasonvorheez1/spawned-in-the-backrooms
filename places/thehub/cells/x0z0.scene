# spawn-scene v2 yaml x0z0
hub-air:
  audience: all
  feetPosition: {x: 0, y: 0, z: 0}
  fx: {script: "fx follow=camera\npop motes n=?mobile:50|110 on=box(<14,4,14>) wrap=14;4;14 size=.008..0.018 v=sdir()*.03 acc=curl(.1)*.06+drag(.6) col=<1,.78,.45> a=(.2..0.5)*flick(.3,.4) sz=$size r=sprite(soft-disc,add)\npop exhaust n=?mobile:8|18 on=box(<26,2,26>) wrap=26;2.5;26 size=3..5.5 v=sdir()*.08 acc=curl(.08)*.05+drag(.4) col=<.6,.48,.35> a=.04..0.08 rot=spin(.02) sz=$size r=sprite(smoke-puff,alpha)"}
  id: hub-air
